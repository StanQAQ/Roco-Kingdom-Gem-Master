# Python 字节码与运行缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Python 虚拟环境与打包缓存
.venv*/
.venv/
venv/
env/
ENV/
__pypackages__/
.tox/
.nox/
pip-wheel-metadata/

# 测试、覆盖率和静态检查缓存
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.pyright/

# PyInstaller 与 Python 构建产物
/build/
/dist/
/release/
*.egg-info/
*.egg
# 不忽略 *.spec：自定义打包配置应纳入版本控制。

# 可执行程序和分发压缩包；正式发布物放到 GitHub Releases
*.exe
*.msi
*.app/
*.dmg
*.pkg
*.zip
*.7z

# 游戏运行日志
/logs/
*.log

# 平衡模拟生成的数据；保留 analysis/ 下的 Markdown 报告和说明
analysis/

# IDE、编辑器和操作系统临时文件
.vscode/
.idea/
*.iml
*.user
*.user.*
*.suo
*.swp
*.swo
.DS_Store
._*
Thumbs.db
Desktop.ini
~$*

# Qt Creator 与 Qt 编译缓存
.qtcreator/
*.qmlc
*.jsc

# 本地环境变量；保留可分享的模板
.env
.env.*
!.env.example

# 临时与备份文件
*.tmp
*.bak

# 本地测试与演示脚本；保留在工作区，不上传至 GitHub
tests/
/src/animation_demo.py
/simulate_balance.py

# 原始文件
original_file/

# codex
.codex/
.aws/
.agents/

